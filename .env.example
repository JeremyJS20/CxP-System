# ── Server ──
PORT=3001
NODE_ENV=production

# ── Database (local dev) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cxp_db
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/cxp_db

# ── Database (Neon producción — fallback si local no está disponible) ──
# Pooled (driver/servidor) — pgbouncer=true para serverless
DATABASE_URL_NEON=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/db?sslmode=require&pgbouncer=true
# Direct (solo para migraciones con Prisma CLI)
DATABASE_URL_DIRECT_NEON=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/db?sslmode=require

# ── Auth ──
JWT_SECRET=change_me_in_production_min_32_chars

# ── CORS ──
# Comma-separated origins. En Vercel se usa https://<project>.vercel.app
CORS_ORIGIN=https://your-app.vercel.app

# ── WS Contabilidad (integración) ──
CONTABILIDAD_WS_URL=https://sistema-contabilidad.onrender.com/api/entradas
CONTABILIDAD_CUENTAS_URL=https://sistema-contabilidad.onrender.com/api/cuentas